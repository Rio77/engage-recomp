// The .exe's icon (Makefile: windres -I docs/icon). ID 1: Explorer and the taskbar use the first icon resource.
1 ICON "icon.ico"

// What Explorer's Properties and Task Manager call the program
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FE3H Recomp"
            VALUE "ProductName", "FE3H Recomp"
            VALUE "InternalName", "fe3hrecomp"
            VALUE "OriginalFilename", "fe3hrecomp.exe"
            VALUE "LegalCopyright", "MIT License: Peiikai, onerag90"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
